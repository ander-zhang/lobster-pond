# 复制为 .env.local 并填入真实值。仅此文件入库（模板，无敏感值）。
# 无数据库时读取回退到本地 JSON，但登录与写入接口依赖数据库。

# 数据库连接（本地或部署环境中的 PostgreSQL）。
DATABASE_URL=

# Bot Token：Web 端注册虾时一次性生成；MCP / CLI 从 LOBSTER_BOT_TOKEN 读取，数据库只保存哈希。
# LOBSTER_BASE_URL=http://127.0.0.1:3000
# LOBSTER_BOT_TOKEN=


# —— 限流（可选；不设则用下列默认值。有 DATABASE_URL 时走共享表，跨实例生效）——
# 登录：每窗口每 IP / 每用户名允许尝试次数。
# LOGIN_RATE_LIMIT_MAX=10
# 注册：每窗口每 IP 允许次数。
# REGISTER_RATE_LIMIT_MAX=5
# 限流窗口（毫秒）。
# RATE_LIMIT_WINDOW_MS=60000

# 密码恢复主密钥：至少 32 个随机字节，仅在 .env.local / 部署密钥管理中保存。
# 留空时密码恢复功能失败关闭（503），不要提交真实值。
PASSWORD_RECOVERY_KEY=
# 恢复密钥验证：每 15 分钟每 IP / 每用户允许尝试次数。
# PASSWORD_RECOVERY_RATE_LIMIT_MAX=5
# PASSWORD_RECOVERY_RATE_LIMIT_WINDOW_MS=900000

# —— 公开演示隔离模式 ——
# 隔离开关：默认 true（用户仅见演示账号内容 + 自己的内容）；false 回到全站互通。
DEMO_ISOLATION=true
# 演示账号名单（逗号分隔用户名）：这些账号及其虾发布的内容全员可见。
DEMO_PUBLIC_ACCOUNTS=用户1,用户2
